---
// Astro Sidebar component
---

<aside id="sidebar" class="fixed top-0 left-0 z-40 flex flex-col h-screen w-52 bg-white border-r-2 border-black transition-all duration-300 ease-in-out">
  <div class="flex items-center h-14 px-4 border-b-2 border-black">
    <a href="/" class="text-lg font-bold mr-2 flex items-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
      </svg>
      <span class="sidebar-text">CARDPOCKET</span>
    </a>
    <button id="toggle-sidebar" class="p-1 rounded-md hover:bg-gray-200 transition-colors duration-200 ml-auto">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>
  
  <nav class="flex-1 overflow-y-auto">
    <a href="/my-pocket" class="flex items-center h-12 px-4 text-sm hover:bg-gray-100">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
      </svg>
      <span class="sidebar-text">My Pocket</span>
    </a>
    <div class="submenu">
      <button class="flex items-center justify-between w-full h-12 px-4 text-sm hover:bg-gray-100">
        <span class="flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
          </svg>
          <span class="sidebar-text">Digimon</span>
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform transition-transform duration-200 arrow-icon" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
      <div class="hidden pl-4 bg-gray-50 submenu-content">
        <a href="/digimon/cards" class="flex items-center h-10 px-4 text-sm hover:bg-gray-100">
          <span class="sidebar-text">Cards</span>
        </a>
        <a href="/digimon/decks" class="flex items-center h-10 px-4 text-sm hover:bg-gray-100">
          <span class="sidebar-text">Decks</span>
        </a>
      </div>
    </div>
    <div class="submenu">
      <button class="flex items-center justify-between w-full h-12 px-4 text-sm hover:bg-gray-100">
        <span class="flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path d="M13 7H7v6h6V7z" />
            <path fill-rule="evenodd" d="M7 2a1 1 0 012 0v1h2V2a1 1 0 112 0v1h2a2 2 0 012 2v2h1a1 1 0 110 2h-1v2h1a1 1 0 110 2h-1v2a2 2 0 01-2 2h-2v1a1 1 0 11-2 0v-1H9v1a1 1 0 11-2 0v-1H5a2 2 0 01-2-2v-2H2a1 1 0 110-2h1V9H2a1 1 0 010-2h1V5a2 2 0 012-2h2V2zM5 5h10v10H5V5z" clip-rule="evenodd" />
          </svg>
          <span class="sidebar-text">Gundam</span>
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform transition-transform duration-200 arrow-icon" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
      <div class="hidden pl-4 bg-gray-50 submenu-content">
        <a href="/gundam/models" class="flex items-center h-10 px-4 text-sm hover:bg-gray-100">
          <span class="sidebar-text">Models</span>
        </a>
        <a href="/gundam/series" class="flex items-center h-10 px-4 text-sm hover:bg-gray-100">
          <span class="sidebar-text">Series</span>
        </a>
      </div>
    </div>
  </nav>
  
  <div class="flex items-center h-14 px-4 border-t-2 border-black">
    <a href="/profile" class="text-sm flex items-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
      </svg>
      <span class="sidebar-text">Spoogy</span>
    </a>
  </div>
</aside>

<style>
  aside {
    border-right: 2px solid #000000;
  }

  aside a:hover, aside button:hover {
    opacity: 0.8;
  }

  #sidebar.collapsed {
    width: 3.5rem;
  }

  #sidebar.collapsed .sidebar-text {
    display: none;
  }

  #sidebar.collapsed #toggle-sidebar {
    margin-left: -0.5rem;
  }

  #sidebar.collapsed .submenu > button > svg:last-child {
    display: none;
  }

  #sidebar.collapsed .submenu-content {
    display: none !important;
  }

  #sidebar.collapsed .h-14 {
    justify-content: center;
  }

  #sidebar.collapsed a, #sidebar.collapsed button {
    justify-content: center;
  }

  #sidebar.collapsed svg {
    margin-right: 0;
  }
</style>

<script>
  function setupSidebar() {
    const sidebar = document.getElementById('sidebar');
    const toggleButton = document.getElementById('toggle-sidebar');
    const submenus = document.querySelectorAll('.submenu');

    if (toggleButton) {
      toggleButton.addEventListener('click', () => {
        sidebar.classList.toggle('collapsed');
      });
    }

    submenus.forEach(submenu => {
      const button = submenu.querySelector('button');
      const content = submenu.querySelector('.submenu-content');
      const arrow = submenu.querySelector('.arrow-icon');
      
      if (button && content && arrow) {
        button.addEventListener('click', () => {
          if (!sidebar.classList.contains('collapsed')) {
            content.classList.toggle('hidden');
            arrow.classList.toggle('rotate-180');
          }
        });
      }
    });
  }

  // Run the setup function when the DOM is loaded
  document.addEventListener('DOMContentLoaded', setupSidebar);

  // If you're using Astro's view transitions, also run the setup function after each navigation
  document.addEventListener('astro:page-load', setupSidebar);
</script>
